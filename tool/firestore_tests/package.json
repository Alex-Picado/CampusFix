{
  "name": "campusfix-firestore-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25.0.0"
  },
  "scripts": {
    "pretest": "node verify_java.mjs",
    "test": "firebase emulators:exec --config ../../firebase.json --project demo-campusfix --only firestore \"node --test --test-concurrency=1\"",
    "test:integration": "node verify_java.mjs && firebase emulators:exec --config ../../firebase.json --project demo-campusfix --only auth,firestore \"node evidence.integration.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.0"
  }
}
