rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Checks whether the request comes from an authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks the current user's stored administrator role.
    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'administrator';
    }

    // Uses the stored role rather than a role supplied in an incident request.
    function isReporter() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'reporter';
    }

    function isTechnician() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'technician';
    }

    function canReadIncidentData(data) {
      return isSignedIn() && (
        data.createdByUserId == request.auth.uid || isAdmin()
        || (isTechnician() && data.assignedTechnicianId == request.auth.uid)
      );
    }

    function canReadIncident(incidentId) {
      let incidentPath = /databases/$(database)/documents/incidents/$(incidentId);
      return exists(incidentPath) && canReadIncidentData(get(incidentPath).data);
    }

    function canAddProgress(incidentId) {
      let parent = get(/databases/$(database)/documents/incidents/$(incidentId)).data;
      return isTechnician() && parent.assignedTechnicianId == request.auth.uid
        && parent.status == 'EN_ATENCION';
    }

    function validProgress(data) {
      return data.keys().hasAll(['authorUserId', 'createdAt', 'description'])
        && data.keys().hasOnly(['authorUserId', 'createdAt', 'description'])
        && data.authorUserId == request.auth.uid && data.createdAt == request.time
        && isNonblankText(data.description);
    }

    function validProgressHistory(data, description) {
      return data.keys().hasAll(['actorUserId', 'createdAt', 'action', 'fromStatus',
          'toStatus', 'fromTechnicianId', 'toTechnicianId', 'reason'])
        && data.keys().hasOnly(['actorUserId', 'createdAt', 'action', 'fromStatus',
          'toStatus', 'fromTechnicianId', 'toTechnicianId', 'reason'])
        && data.actorUserId == request.auth.uid && data.createdAt == request.time
        && data.action == 'progressAdded' && data.fromStatus == 'EN_ATENCION'
        && data.toStatus == 'EN_ATENCION' && data.fromTechnicianId == null
        && data.toTechnicianId == null && data.reason == description;
    }

    // Validates the bidirectional link between an incident update and a new event.
    function validWorkflowEvent(before, next, event) {
      let details = event.details;
      return event.keys().hasAll(['actorUserId', 'createdAt', 'action', 'fromStatus',
          'toStatus', 'fromTechnicianId', 'toTechnicianId', 'reason', 'details', 'previousResolutionDescription'])
        && event.keys().hasOnly(['actorUserId', 'createdAt', 'action', 'fromStatus',
          'toStatus', 'fromTechnicianId', 'toTechnicianId', 'reason', 'details', 'previousResolutionDescription'])
        && details is map && details.keys().hasAll(['categoryId', 'priority', 'technicianId', 'reason'])
        && details.keys().hasOnly(['categoryId', 'priority', 'technicianId', 'reason'])
        && event.actorUserId == request.auth.uid && event.createdAt == request.time
        && event.fromStatus == before.status && event.toStatus == next.status
        && event.fromTechnicianId == before.assignedTechnicianId
        && event.toTechnicianId == next.assignedTechnicianId
        && event.reason == details.reason
        && ((event.action == 'classified' && details.categoryId == next.categoryId && details.priority == next.priority)
          || (event.action != 'classified' && details.categoryId == null && details.priority == null))
        && ((event.action == 'assigned' && details.technicianId == next.assignedTechnicianId)
          || (event.action != 'assigned' && details.technicianId == null))
        && ((event.action in ['resolved', 'rejected', 'cancelled', 'reopened'] && isNonblankText(event.reason)
              && event.reason == event.reason.trim())
          || (event.action in ['classified', 'assigned', 'started', 'closed'] && event.reason == null))
        && ((event.action == 'reopened' && event.previousResolutionDescription == before.resolutionDescription)
          || (event.action != 'reopened' && event.previousResolutionDescription == null));
    }

    function validWorkflowTransition(before, next, event) {
      let changed = next.diff(before).affectedKeys();
      let common = ['status', 'updatedAt', 'lastWorkflowEventId'];
      return (
        isAdmin() && (
          (event.action == 'classified' && before.status in ['REPORTADA', 'EN_REVISION']
            && next.status == 'EN_REVISION'
            && changed.hasOnly(common.concat(['categoryId', 'priority']))
            && isDocumentId(next.categoryId) && isActiveCategory(next.categoryId)
            && next.priority in ['BAJA', 'MEDIA', 'ALTA'])
          || (event.action == 'assigned' && before.status == 'EN_REVISION' && next.status == 'ASIGNADA'
            && changed.hasOnly(common.concat(['assignedTechnicianId']))
            && next.priority in ['BAJA', 'MEDIA', 'ALTA'] && isActiveCategory(next.categoryId)
            && isDocumentId(next.assignedTechnicianId)
            && get(/databases/$(database)/documents/users/$(next.assignedTechnicianId)).data.role == 'technician')
          || (event.action == 'closed' && before.status == 'RESUELTA' && next.status == 'CERRADA'
            && changed.hasOnly(common))
          || (event.action == 'rejected' && before.status == 'EN_REVISION' && next.status == 'RECHAZADA'
            && changed.hasOnly(common))
          || (event.action == 'cancelled' && before.status in ['REPORTADA', 'EN_REVISION', 'ASIGNADA', 'EN_ATENCION']
            && next.status == 'CANCELADA' && changed.hasOnly(common))
          || (event.action == 'reopened' && before.status in ['RESUELTA', 'CERRADA'] && next.status == 'EN_REVISION'
            && changed.hasOnly(common.concat(['assignedTechnicianId', 'priority', 'resolutionDescription']))
            && next.assignedTechnicianId == null && next.priority == null && next.resolutionDescription == null)
        )
      ) || (
        isTechnician() && before.assignedTechnicianId == request.auth.uid && (
          (event.action == 'started' && before.status == 'ASIGNADA' && next.status == 'EN_ATENCION'
            && changed.hasOnly(common))
          || (event.action == 'resolved' && before.status == 'EN_ATENCION' && next.status == 'RESUELTA'
            && changed.hasOnly(common.concat(['resolutionDescription']))
            && next.resolutionDescription == event.reason && isNonblankText(next.resolutionDescription))
        )
      );
    }

    function validWorkflowChange(before, next, event) {
      return next.updatedAt == request.time && isDocumentId(next.lastWorkflowEventId)
        && before.get('lastWorkflowEventId', null) != next.lastWorkflowEventId
        && validWorkflowEvent(before, next, event)
        && validWorkflowTransition(before, next, event);
    }

    function hasWorkflowEvent(incidentId) {
      let eventId = request.resource.data.lastWorkflowEventId;
      let eventPath = /databases/$(database)/documents/incidents/$(incidentId)/history/$(eventId);
      return eventId != 'created' && !exists(eventPath)
        && validWorkflowChange(resource.data, request.resource.data, getAfter(eventPath).data);
    }

    function workflowReferencesUpdate(incidentId, eventId) {
      let parent = /databases/$(database)/documents/incidents/$(incidentId);
      let before = get(parent).data;
      let next = getAfter(parent).data;
      return eventId != 'created' && next.lastWorkflowEventId == eventId
        && validWorkflowChange(before, next, request.resource.data);
    }

    function validEvidence(data, incidentId, evidenceId) {
      return data.keys().hasAll(['uploadedByUserId', 'createdAt', 'provider', 'assetId',
          'url', 'fileName', 'contentType', 'sizeBytes', 'progressId'])
        && data.keys().hasOnly(['uploadedByUserId', 'createdAt', 'provider', 'assetId',
          'url', 'fileName', 'contentType', 'sizeBytes', 'progressId'])
        && data.uploadedByUserId == request.auth.uid && data.createdAt == request.time
        && data.provider == 'local' && data.assetId == incidentId + '/' + evidenceId
        && data.url == '/incidents/' + incidentId + '/evidence/' + evidenceId
        && isNonblankText(data.fileName) && data.fileName.size() <= 160
        && data.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes <= 3000000;
    }

    function isNonblankText(value) {
      return value is string && value.trim().size() > 0;
    }

    // Keeps dynamic document references within a single valid path segment.
    function isDocumentId(value) {
      return isNonblankText(value)
        && value == value.trim()
        && value.matches('[^/]+')
        && value != '.' && value != '..'
        && !value.matches('(?s)__.*__');
    }

    function isActiveCategory(categoryId) {
      let category = get(/databases/$(database)/documents/categories/$(categoryId)).data;
      return category.isActive == true && isNonblankText(category.name);
    }

    // A counter cannot be reset, extended with arbitrary fields or rounded on web.
    function isValidIncidentCounter(data) {
      return data.keys().hasAll(['lastSequenceNumber', 'lastIncidentId'])
        && data.keys().hasOnly(['lastSequenceNumber', 'lastIncidentId'])
        && data.lastSequenceNumber is int
        && data.lastSequenceNumber >= 1
        && data.lastSequenceNumber <= 9007199254740991
        && isDocumentId(data.lastIncidentId);
    }

    function isValidNewIncident(data) {
      return data.keys().hasAll([
          'sequenceNumber', 'title', 'description', 'categoryId', 'location',
          'priority', 'status', 'createdAt', 'updatedAt', 'createdByUserId',
          'assignedTechnicianId', 'resolutionDescription'
        ])
        && data.keys().hasOnly([
          'sequenceNumber', 'title', 'description', 'categoryId', 'location',
          'priority', 'status', 'createdAt', 'updatedAt', 'createdByUserId',
          'assignedTechnicianId', 'resolutionDescription'
        ])
        && data.sequenceNumber is int
        && data.sequenceNumber >= 1
        && data.sequenceNumber <= 9007199254740991
        && isNonblankText(data.title)
        && isNonblankText(data.description)
        && isNonblankText(data.location)
        && isDocumentId(data.categoryId)
        && data.createdByUserId == request.auth.uid
        && data.status == 'REPORTADA'
        && data.priority == null
        && data.assignedTechnicianId == null
        && data.resolutionDescription == null
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && isActiveCategory(data.categoryId);
    }

    function isValidInitialHistory(data) {
      return data.keys().hasAll([
          'actorUserId', 'createdAt', 'action', 'fromStatus', 'toStatus',
          'fromTechnicianId', 'toTechnicianId', 'reason'
        ])
        && data.keys().hasOnly([
          'actorUserId', 'createdAt', 'action', 'fromStatus', 'toStatus',
          'fromTechnicianId', 'toTechnicianId', 'reason'
        ])
        && data.actorUserId == request.auth.uid
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.action == 'created'
        && data.fromStatus == null && data.toStatus == 'REPORTADA'
        && data.fromTechnicianId == null && data.toTechnicianId == null
        && data.reason == null;
    }

    // The increment must identify this report and advance the previous value by one.
    function hasCreationCounter(incidentId, sequenceNumber) {
      let counterPath = /databases/$(database)/documents/counters/incidents;
      let next = getAfter(counterPath).data;
      return isValidIncidentCounter(next)
        && next.lastIncidentId == incidentId
        && next.lastSequenceNumber == sequenceNumber
        && (
          (!exists(counterPath) && sequenceNumber == 1)
          || (exists(counterPath)
            && isValidIncidentCounter(get(counterPath).data)
            && sequenceNumber == get(counterPath).data.lastSequenceNumber + 1)
        );
    }

    function hasNewInitialHistory(incidentId) {
      let eventPath = /databases/$(database)/documents/incidents/$(incidentId)/history/created;
      return !exists(eventPath) && isValidInitialHistory(getAfter(eventPath).data);
    }

    // A counter update requires a fresh report in the same atomic operation.
    function counterReferencesNewIncident(data) {
      let incidentPath = /databases/$(database)/documents/incidents/$(data.lastIncidentId);
      let incident = getAfter(incidentPath).data;
      return !exists(incidentPath)
        && incident.createdByUserId == request.auth.uid
        && incident.sequenceNumber == data.lastSequenceNumber;
    }

    function historyReferencesNewIncident(incidentId) {
      let incidentPath = /databases/$(database)/documents/incidents/$(incidentId);
      let incident = getAfter(incidentPath).data;
      return !exists(incidentPath)
        && incident.createdByUserId == request.auth.uid
        && incident.status == 'REPORTADA'
        && incident.createdAt == request.time;
    }

    // Validates the complete incoming profile document.
    function isValidProfile() {
      let data = request.resource.data;

      return data.keys().hasAll(['fullName', 'email', 'role'])
        && data.keys().hasOnly(['fullName', 'email', 'role'])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.email is string
        && data.email.size() > 0
        && data.role is string
        && data.role in ['reporter', 'technician', 'administrator'];
    }

    match /users/{userId} {

      // Owners may read their own profile, even before it exists.
      // Administrators may read any profile.
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      // Only administrators may query the users collection.
      allow list: if isAdmin();

      // Self-registration creates only a reporter profile.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidProfile()
        && request.resource.data.role == 'reporter'
        && request.resource.data.email == request.auth.token.email;

      // Owners may edit their names; administrators may change roles.
      allow update: if isSignedIn()
        && isValidProfile()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['fullName'])
          )
          ||
          (
            isAdmin()
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['role'])
          )
        );

      allow delete: if false;
    }

    match /categories/{categoryId} {
      // Queries must filter by isActive to request only readable documents.
      allow get, list: if isSignedIn() && resource.data.isActive == true;

      // Category administration is not exposed by the reporting reader.
      allow create, update, delete: if false;
    }

    match /incidents/{incidentId} {
      // Valid profiles may probe missing IDs; existing records require detail access.
      allow get: if isSignedIn()
        && ((resource == null && (isReporter() || isAdmin() || isTechnician()))
          || canReadIncidentData(resource.data));
      // Reporter queries must constrain createdByUserId to their own UID.
      allow list: if isAdmin()
        || (isReporter() && resource.data.createdByUserId == request.auth.uid)
        || (isTechnician() && resource.data.assignedTechnicianId == request.auth.uid);

      allow create: if isReporter()
        && isDocumentId(incidentId)
        && isValidNewIncident(request.resource.data)
        && hasCreationCounter(incidentId, request.resource.data.sequenceNumber)
        && hasNewInitialHistory(incidentId);
      allow update: if isSignedIn() && hasWorkflowEvent(incidentId);
      allow delete: if false;

      match /history/{eventId} {
        allow create: if (eventId == 'created'
          && isReporter()
          && isValidInitialHistory(request.resource.data)
          && historyReferencesNewIncident(incidentId))
          || (eventId != 'created' && isDocumentId(eventId) && canAddProgress(incidentId)
            && !exists(/databases/$(database)/documents/incidents/$(incidentId)/progress/$(eventId))
            && validProgress(getAfter(/databases/$(database)/documents/incidents/$(incidentId)/progress/$(eventId)).data)
            && validProgressHistory(request.resource.data,
              getAfter(/databases/$(database)/documents/incidents/$(incidentId)/progress/$(eventId)).data.description))
          || (isSignedIn() && isDocumentId(eventId) && workflowReferencesUpdate(incidentId, eventId));
        allow read: if canReadIncident(incidentId);
        allow update, delete: if false;
      }

      match /progress/{progressId} {
        allow read: if canReadIncident(incidentId);
        allow create: if progressId != 'created' && isDocumentId(progressId)
          && canAddProgress(incidentId) && validProgress(request.resource.data)
          && !exists(/databases/$(database)/documents/incidents/$(incidentId)/history/$(progressId))
          && validProgressHistory(getAfter(/databases/$(database)/documents/incidents/$(incidentId)/history/$(progressId)).data,
            request.resource.data.description);
        allow update, delete: if false;
      }

      match /evidence/{evidenceId} {
        allow read: if canReadIncident(incidentId);
        allow create: if isDocumentId(evidenceId) && isSignedIn()
          && validEvidence(request.resource.data, incidentId, evidenceId)
          && ((request.resource.data.progressId == null && isReporter()
              && get(/databases/$(database)/documents/incidents/$(incidentId)).data.createdByUserId == request.auth.uid)
            || (isDocumentId(request.resource.data.progressId) && canAddProgress(incidentId)
              && !exists(/databases/$(database)/documents/incidents/$(incidentId)/progress/$(request.resource.data.progressId))
              && validProgress(getAfter(/databases/$(database)/documents/incidents/$(incidentId)/progress/$(request.resource.data.progressId)).data)));
        allow update, delete: if false;
      }
    }

    match /counters/incidents {
      allow get: if isReporter();
      allow list, delete: if false;

      allow create: if isReporter()
        && isValidIncidentCounter(request.resource.data)
        && request.resource.data.lastSequenceNumber == 1
        && counterReferencesNewIncident(request.resource.data);

      allow update: if isReporter()
        && isValidIncidentCounter(resource.data)
        && isValidIncidentCounter(request.resource.data)
        && request.resource.data.lastSequenceNumber == resource.data.lastSequenceNumber + 1
        && counterReferencesNewIncident(request.resource.data);
    }

    // Other collections require their own module-specific rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
